{
  "name": "react-colorscales",
  "version": "0.7.3",
  "description": "A React component for picking colorscales based on Chroma.js",
  "main": "build/index.js",
  "files": [
    "build/index.js"
  ],
  "scripts": {
    "install": "npm install --ignore-scripts",
    "start": "webpack-dev-server --hot",
    "build": "node ./scripts/build.js",
    "buildDemoBundle": "webpack --output-path ./docs --output-filename bundle.js",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plotly/react-colorscales.git"
  },
  "author": "Jack Parmer <jack@plot.ly>",
  "bugs": {
    "url": "https://github.com/plotly/react-colorscales/issues"
  },
  "homepage": "https://github.com/plotly/react-colorscales#readme",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-private-property-in-object": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-stage-0": "7.8.3",
    "ajv": "8.20.0",
    "autoprefixer": "10.5.4",
    "babel-jest": "30.4.1",
    "babel-loader": "10.1.1",
    "chalk": "4.1.2",
    "css-loader": "7.1.4",
    "file-loader": "6.2.0",
    "fs-extra": "11.3.6",
    "node-forge": "1.4.0",
    "plotly.js": "3.7.0",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-loader": "8.2.1",
    "ramda": "0.32.0",
    "react": "17.0.2",
    "react-dev-utils": "12.0.1",
    "react-dom": "17.0.2",
    "react-hot-loader": "4.13.1",
    "react-plotly.js": "2.6.0",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.6.1",
    "uglify-js": "3.19.3",
    "url-loader": "4.1.1",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.1",
    "webpack-dev-server": "6.0.0"
  },
  "peerDependencies": {
    "react": ">=0.14",
    "react-dom": ">=0.14"
  },
  "dependencies": {
